DOMAIN=:80
POSTGRES_PASSWORD=adminpassword
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
INTERNAL_API_KEY=diplom-dev-internal-key
LLM_API_KEY=your_llm_api_key_here
# LLM provider (any OpenAI-compatible API). Default: OpenRouter — one key for chat + embeddings,
# per-request cost in usage.cost, Anthropic prompt caching passed through.
#   LLM_BASE_URL=https://openrouter.ai/api/v1/
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=google/gemini-2.5-flash-lite        # default model (solo / paired rooms)
# Gemini directly instead of OpenRouter:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash-lite
#LLM_BASE_URL=
#LLM_MODEL=
# Diary: per-role models (empty = LLM_MODEL). The diary benefits from a stronger model.
#DIARY_LLM_MODEL=anthropic/claude-sonnet-4.5
#SUMMARY_LLM_MODEL=
#FACTS_LLM_MODEL=
# Diary RAG embeddings. EMBEDDINGS_DIMS is baked into the DB migration (V6) — do not change after first start.
# Defaults: same base-url/key as LLM_*, model openai/text-embedding-3-small, 768 dims.
# If your chat provider has no /embeddings endpoint, point these at one that does, e.g. Gemini:
#   EMBEDDINGS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   EMBEDDINGS_API_KEY=...
#   EMBEDDINGS_MODEL=gemini-embedding-001
#EMBEDDINGS_BASE_URL=
#EMBEDDINGS_API_KEY=
#EMBEDDINGS_MODEL=
#EMBEDDINGS_DIMS=768
